[Unit]
Description=Upgrade installed managed baseline packages
After=network-online.target
Wants=network-online.target
{% if base_maintenance_failure_slack_notify_enabled | default(true) %}
OnFailure=ansible-pull-slack-notify@%n.service
{% endif %}

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/upgrade-installed-apt-packages --label managed-baseline --list-file /etc/ansible/managed-package-updates.list{% for rv in base_managed_package_updates_restart_verify | default([]) %} --restart-verify {{ rv.service }}:{{ rv.trigger_packages | join(',') }}{% endfor +%}
TimeoutStartSec=30m
